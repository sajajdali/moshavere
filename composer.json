{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Jesmino shemiranweb project.",
    "keywords": [
        "laravel",
        "framework",
        "Jesmino",
        "shemiranweb"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/recaptcha": "^1.3",
        "guzzlehttp/guzzle": "^7.8.1",
        "hekmatinasser/verta": "^8.3",
        "laravel-notification-channels/fcm": "^4.1.0",
        "laravel/framework": "^11.0.0",
        "laravel/octane": "^2.3",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8.2",
        "livewire/livewire": "^3.4.11",
        "maatwebsite/excel": "^3.1",
        "mhmiton/laravel-modules-livewire": "3.0.0",
        "nwidart/laravel-modules": "^11.0",
        "pusher/pusher-php-server": "^7.2.4",
        "spatie/laravel-permission": "^6.9.0",
        "tecnickcom/tcpdf": "^6.7.5"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.0.0",
        "fakerphp/faker": "^1.23.1",
        "laravel/pint": "^1.13.7",
        "laravel/sail": "^1.26.3",
        "mockery/mockery": "^1.6.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "*",
        "phpunit/phpunit": "^10.5.2",
        "spatie/laravel-ignition": "^2.3.1"
    },
    "autoload": {
        "files": [
            "helper/jdf.php",
            "helper/function.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
